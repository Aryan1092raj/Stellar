DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geoledger
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email delivery
RESEND_API_KEY=
RESEND_FROM=GeoLedger <onboarding@resend.dev>

# Firebase Admin for Google auth token verification
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# IPFS / Pinata for evidence uploads
WEB3_STORAGE_TOKEN=your-web3-storage-token
PINATA_API_KEY=
PINATA_SECRET_KEY=
IPFS_PINATA_API_KEY=
IPFS_PINATA_SECRET=

# Stellar Network Configuration
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
DONATION_REGISTRY_CONTRACT_ID=
NGO_VERIFICATION_CONTRACT_ID=
EVIDENCE_CONTRACT_ID=
NATIVE_TOKEN_CONTRACT_ID=

# Google Gemini AI for Chatbot
GEMINI_API_KEY=your-gemini-api-key-here

# Bulk NGO-DARPAN import
# Download/export a NGO-DARPAN/Dataful CSV locally, then run npm run import:ngos -- --file data/indian-ngos.csv
NGO_IMPORT_FILE=
NGO_IMPORT_SOURCE=ngo-darpan
NGO_IMPORT_DEFAULT_STATUS=pending
NGO_IMPORT_LIMIT=
NGO_IMPORT_DRY_RUN=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
