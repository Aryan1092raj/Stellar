generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Donation {
  id                 Int      @id @default(autoincrement())
  donor_public_key   String
  amount             Float
  ngo_id             Int
  project_id         Int?
  donor_lat          Float
  donor_lng          Float
  recipient_lat      Float?
  recipient_lng      Float?
  status             String
  chain_create_tx    String?
  chain_verify_tx    String?
  soroban_contract_id String?
  evidence_url       String?
  evidence_cid       String?
  evidence_tx        String?
  tx_confirmed       Boolean  @default(false)
  created_at         DateTime @default(now())
}

model NGO {
  id                  Int      @id @default(autoincrement())
  name                String   @unique
  wallet_address      String
  verification_status String
  sector              String?
  source              String?
  source_id           String?  @unique
  email               String?
  state               String?
  district            String?
  city                String?
  registration_number String?
  type_of_ngo         String?
  impact_metrics      Json?
  locations           Json?
  created_at          DateTime @default(now())

  @@index([source])
  @@index([state])
  @@index([district])
}

model Project {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  ngo_id          Int
  latitude        Float?
  longitude       Float?
  target_amount   Float?
  sector          String?
  cover_image_url String?
  deadline        DateTime?
  created_at      DateTime @default(now())

  @@index([ngo_id])
  @@index([deadline])
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String?
  googleUid  String?  @unique
  avatar     String?
  role       String
  created_at DateTime @default(now())
}
